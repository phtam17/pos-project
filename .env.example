NODE_ENV=development
APP_MODE=sandbox
PUBLIC_SANDBOX=false
HOST=127.0.0.1
PORT=3000
PERSISTENCE_MODE=postgres
DATABASE_URL=postgres://pos:pos@localhost:5433/pos
SIMULATED_WEBHOOK_SECRET=local-sandbox-webhook-secret-change-before-sharing
SANDBOX_AUTH_ENABLED=true
AUTH_SECRET=local-sandbox-auth-secret-change-before-sharing
DEMO_CASHIER_PIN=1234
DEMO_MANAGER_PIN=2468
SESSION_DURATION_MINUTES=480
MANAGER_APPROVAL_MINUTES=5
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=240
LOGIN_RATE_LIMIT_MAX=8
DEMO_RESET_ENABLED=true
DEMO_RESET_INTERVAL_MINUTES=0
