{
  "name": "open-pos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:register",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/server.ts",
    "dev:register": "vite --config apps/register/vite.config.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/main.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/persistence/src/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx packages/persistence/src/seed.ts",
    "smoke:postgres": "node --env-file-if-exists=.env --import tsx scripts/postgres-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm --workspace @pos/register run build",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
