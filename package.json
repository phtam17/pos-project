{
  "name": "varipos",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phtam17/pos-project.git"
  },
  "bugs": {
    "url": "https://github.com/phtam17/pos-project/issues"
  },
  "homepage": "https://github.com/phtam17/pos-project#readme",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run-development.mjs",
    "start": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/server.ts",
    "dev:register": "vite --config apps/register/vite.config.ts",
    "worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/main.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/persistence/src/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx packages/persistence/src/seed.ts",
    "db:prepare": "node --env-file-if-exists=.env --import tsx scripts/prepare-database.ts",
    "smoke:postgres": "node --env-file-if-exists=.env --import tsx scripts/postgres-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm --workspace @pos/register run build",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "postcss": "^8.5.29",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
